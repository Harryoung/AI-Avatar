#!/usr/bin/env bash
set -euo pipefail

root_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "${root_dir}"

export GIT_TERMINAL_PROMPT=0

export AVATAR_WORKSPACE_DIR="${AVATAR_WORKSPACE_DIR:-$(cd "${root_dir}/../.." && pwd)/workspace}"
if [[ -f "${root_dir}/../shared/sync-agent-files.sh" ]]; then
  bash "${root_dir}/../shared/sync-agent-files.sh" || echo "[warn] sync-agent-files failed" >&2
fi

dt="$(date -Iseconds)"
prompt="当前时间 ${dt}，请按你的计划推进并在需要时同步阻塞点。"

./claude-docker run -p "${prompt}"
