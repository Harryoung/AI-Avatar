#!/usr/bin/env bash
set -euo pipefail

root_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "${root_dir}"

lock_dir="/tmp/ai-avatar-codex-cron.lock"
if ! mkdir "${lock_dir}" 2>/dev/null; then
  echo "已有 codex 定时任务在运行，跳过本次。"
  exit 0
fi
trap 'rmdir "${lock_dir}" 2>/dev/null || true' EXIT

export GIT_TERMINAL_PROMPT=0
timeout_seconds="${CODEX_CRON_TIMEOUT_SECONDS:-2700}"
dt="$(date -Iseconds)"
prompt="当前时间 ${dt}，请按你的计划推进并在需要时同步阻塞点。"

if command -v perl >/dev/null 2>&1; then
  perl -e 'alarm shift; exec @ARGV' "${timeout_seconds}" ./codex-docker run exec --dangerously-bypass-approvals-and-sandbox --skip-git-repo-check "${prompt}"
else
  ./codex-docker run exec --dangerously-bypass-approvals-and-sandbox --skip-git-repo-check "${prompt}"
fi
