#!/usr/bin/env bash
set -euo pipefail

root_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
compose_file="${root_dir}/codex_docker/compose.yml"

export HOST_UID="${HOST_UID:-$(id -u)}"
export HOST_GID="${HOST_GID:-$(id -g)}"
export AVATAR_WORKSPACE_DIR="${AVATAR_WORKSPACE_DIR:-$(cd "${root_dir}/../.." && pwd)/workspace}"

dc() { docker compose -f "${compose_file}" "$@"; }

dc_run() {
  local -a args
  args=(run --rm)
  if [[ ! -t 0 ]]; then
    args+=(-T)
  fi
  dc "${args[@]}" "$@"
}

fail() {
  echo "错误: $*" >&2
  exit 2
}

preflight() {
  command -v docker >/dev/null 2>&1 || fail "未安装 Docker。请先安装 Docker Desktop。"
  docker compose version >/dev/null 2>&1 || fail "未检测到 docker compose。请升级 Docker Desktop。"
  [[ -d "${AVATAR_WORKSPACE_DIR}" ]] || fail "工作目录不存在: ${AVATAR_WORKSPACE_DIR}。请先 mkdir -p ${AVATAR_WORKSPACE_DIR}"
}

usage() {
  cat <<'HELP'
用法:
  ./runtime/codex/codex-docker help
  ./runtime/codex/codex-docker build
  ./runtime/codex/codex-docker run
  ./runtime/codex/codex-docker shell
  ./runtime/codex/codex-docker login-device
  ./runtime/codex/codex-docker status
  ./runtime/codex/codex-docker logout
  ./runtime/codex/codex-docker set-github-token
  ./runtime/codex/codex-docker unset-github-token

示例:
  ./runtime/codex/codex-docker build
  AVATAR_WORKSPACE_DIR=$PWD/workspace ./runtime/codex/codex-docker run
HELP
}

preflight

set_github_token() {
  local token="${1:-}"
  if [[ -z "${token}" ]]; then
    read -r -s -p "GITHUB_TOKEN: " token
    echo
  fi
  [[ -n "${token}" ]] || fail "GITHUB_TOKEN 不能为空。"
  # shellcheck disable=SC2016
  dc_run -e _TOKEN="${token}" codex bash -lc '
    set -euo pipefail
    umask 077
    mkdir -p "$HOME/.config/git"
    git config --global credential.helper "store --file $HOME/.config/git/credentials"
    printf "https://x-access-token:%s@github.com\n" "$_TOKEN" > "$HOME/.config/git/credentials"
  '
  echo "已写入 GitHub token 到 volume。"
}

case "${1:-run}" in
  help|-h|--help)
    usage
    ;;
  build)
    shift
    dc build "$@"
    ;;
  run)
    shift
    dc_run codex codex "$@"
    ;;
  shell)
    shift
    dc_run codex bash "$@"
    ;;
  login-device)
    shift
    dc_run codex codex login --device-auth "$@"
    ;;
  status)
    shift
    dc_run codex codex login status "$@"
    ;;
  logout)
    shift
    dc_run codex codex logout "$@"
    ;;
  set-github-token)
    shift
    set_github_token "${1:-}"
    ;;
  unset-github-token)
    # shellcheck disable=SC2016
    dc_run codex bash -lc 'rm -f "$HOME/.config/git/credentials"'
    echo "已删除 GitHub token。"
    ;;
  *)
    dc_run codex codex "$@"
    ;;
esac
